        "physiological_range": {
          "normal_min": 0.0,
          "normal_max": 15.0,
          "critical_min": 0.0,
          "critical_max": 15.0
        },
        "description": "Immune cell baseline (~x2* = s/d = 6.67)"
      },
      "x3": {
        "distribution": "lognormal",
        "mean": 1.0,
        "std": 0.30,
        "clip_min": 0.1,
        "clip_max": 5.0,
        "physiological_range": {
          "normal_min": 0.0,
          "normal_max": 5.0,
          "critical_min": 0.0,
          "critical_max": 5.0
        },
        "description": "Effector cell baseline (below drug-free SS x3* ≈ 2.15)"
