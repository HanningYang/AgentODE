          "normal_min": 0.0,
          "normal_max": 10.0,
          "critical_min": 0.0,
          "critical_max": 10.0
        },
        "description": "Drug depot amount at dose time"
      },
      "x1": {
        "distribution": "fixed",
        "value": 0.0,
